# Committed defaults. Override per machine in .env.local (gitignored) or in the shell.
# UserListServer's origin. Used by the Vite proxy (vite.config.ts) and by `npm run schema:pull`.
VITE_SERVER_URL=http://localhost:4000
# GraphQL endpoint path. The app calls it on its own origin and Vite proxies it to VITE_SERVER_URL + this path.
VITE_GRAPHQL_URL_PATH=/graphql
# Prefix of every REST route (e.g. /api/login, /api/session). The app calls it on its own origin and Vite
# proxies it to VITE_SERVER_URL + this path.
VITE_API_URL_PATH=/api
